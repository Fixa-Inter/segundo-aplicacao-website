{
  "name": "fixa-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node ./node_modules/vite/bin/vite.js",
    "build": "node ./node_modules/typescript/bin/tsc -b && node ./node_modules/vite/bin/vite.js build",
    "lint": "node ./node_modules/eslint/bin/eslint.js .",
    "test": "node --test tests/*.test.mjs",
    "format": "node ./node_modules/prettier/bin/prettier.cjs --write src tests scripts dev/compose.yml dev/compose.shared.yml package.json eslint.config.js vite.config.ts index.html",
    "format:check": "node ./node_modules/prettier/bin/prettier.cjs --check src tests scripts dev/compose.yml dev/compose.shared.yml package.json eslint.config.js vite.config.ts index.html",
    "preview": "node ./node_modules/vite/bin/vite.js preview",
    "local:prepare": "node scripts/local-api.mjs prepare",
    "local:up": "node scripts/local-api.mjs up",
    "local:shared": "node scripts/local-api.mjs shared",
    "local:down": "node scripts/local-api.mjs down",
    "local:status": "node scripts/local-api.mjs status",
    "local:logs": "node scripts/local-api.mjs logs",
    "test:browser": "node --test --test-concurrency=1 tests/browser/*.test.mjs"
  },
  "dependencies": {
    "@fontsource/poppins": "^5.3.0",
    "@mantine/core": "^9.6.2",
    "@mantine/hooks": "^9.6.2",
    "axios": "^1.20.0",
    "lucide-react": "^1.47.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.3.0"
  }
}
