# URL pública do servidor Spring Boot, sem /api/v1 no final.
# Copie para .env.local e informe o endereço real; reinicie o Vite.
VITE_API_BASE_URL=http://localhost:8080

# Serviço da Manu, sem /api/v1 no final. Chaves de provedores ficam somente no servidor.
VITE_AI_BASE_URL=http://localhost:8000

# Alternativa AWS: use os dois serviços do mesmo ambiente em .env.local.
# VITE_API_BASE_URL=https://web-api.fixa.solutions
# VITE_AI_BASE_URL=https://ia-api.fixa.solutions
# A IA publicada ainda precisa das rotas de histórico e CORS da branch de integração.
# Consulte docs/INTEGRACAO_IA_2026-10-25.md antes de validar a integração na AWS.
