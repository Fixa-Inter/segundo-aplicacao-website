# API Web publicada na AWS. Para Docker local, use http://localhost:8080.
VITE_API_BASE_URL=https://web-api.fixa.solutions

# Caminho da própria web, encaminhado pelo Vite/Vercel para a IA existente.
VITE_AI_BASE_URL=/api/ia
AI_PROXY_TARGET=https://ia-api.fixa.solutions

# Configuração pública de upload unsigned autorizado pelo responsável do Cloudinary.
# Nunca coloque API Secret, credenciais de banco, JWT_SECRET ou chaves de modelos em VITE_*.
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=
VITE_CLOUDINARY_FOLDER=

# URL de incorporação fornecida pelo responsável do Databricks.
VITE_DATABRICKS_DASHBOARD_URL=https://dbc-7dc0a7b3-a574.cloud.databricks.com/embed/dashboardsv3/01f1d0be95ef1d86b90737aa9639b671?o=7474651714950692
