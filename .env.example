# API Web publicada na AWS. Para Docker local, use http://localhost:8080.
VITE_API_BASE_URL=https://web-api.fixa.solutions

# Caminho da própria web, encaminhado pelo Vite/Vercel para a IA existente.
VITE_AI_BASE_URL=/api/ia
AI_PROXY_TARGET=https://ia-api.fixa.solutions

# Configuração pública de upload unsigned autorizado pelo responsável do Cloudinary.
# Nunca coloque API Secret, credenciais de banco, JWT_SECRET ou chaves de modelos em VITE_*.
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=
VITE_CLOUDINARY_FOLDER=

# O dashboard/workspace e o token restrito à unidade vêm de GET /api/v1/dashboard/embed.
# Credenciais Databricks pertencem à API, nunca a VITE_*.

# Gráfico único da Home: identificador de página~widget copiado do Databricks.
VITE_DATABRICKS_HOME_WIDGET=a5185eb0~solicitacoes-por-periodo

# Gráfico de OS e filtro de nome completo publicados para a ficha do técnico.
VITE_DATABRICKS_TECHNICIAN_WIDGET=37645ca6~os-criadas-por-periodo
VITE_DATABRICKS_TECHNICIAN_FILTER=f_37645ca6~tecnico1.s
