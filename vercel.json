{
  "headers": [
    {
      "source": "/api/ia/:path*",
      "headers": [{ "key": "Cache-Control", "value": "private, no-store" }]
    }
  ],
  "rewrites": [
    { "source": "/api/ia/:path*", "destination": "https://ia-api.fixa.solutions/:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
